# Google Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Database backend mode: postgres | sqlite | hybrid
DATABASE_BACKEND=hybrid

# Runtime SQLite database file
SQLITE_DATABASE_URL=sqlite:///./data/autocareer.db

# PostgreSQL URL (active in postgres mode, sync peer in hybrid mode)
POSTGRES_DATABASE_URL=postgresql://user:password@postgres:5432/autocareer

# Auto sync controls
DB_SYNC_ENABLED=true
SYNC_ON_BOOT=true
SYNC_ON_SHUTDOWN=true

# Apply pipeline retries (tailoring/hook failures)
MAX_RETRIES=3

# SSE stream queue wait behavior (seconds)
STREAM_QUEUE_WAIT_TIMEOUT_SECONDS=1.0
STREAM_QUEUE_WAIT_INTERVAL_SECONDS=0.05

# Startup health behavior
STARTUP_FAIL_FAST=true
STARTUP_BLOCK_APPLY_ON_CRITICAL=true
STARTUP_SCRAPER_TIMEOUT_SECONDS=5
